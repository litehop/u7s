
# Mayor Method working files — ignore content but keep the stub so the
# directory exists in all worktrees.
ai/findings/*
!ai/findings/.gitkeep

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

target
.claude/scheduled_tasks.lock
ai/worktrees/
.aqua/

# Generated TLS / signing-key files (written by u7s-apiserver on first start)
ca.key
ca.crt
sa.key
sa.pub
/kubeconfig

# Local dev state (scripts/u7s-start.sh)
temp/*
!temp/u7s/
!temp/u7s/.gitkeep
!temp/u7s-lima-node-smoke/
!temp/u7s-lima-node-smoke/.gitkeep

.claude/scheduled_tasks.json
.claude/plans/
