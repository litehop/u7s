
# Mayor Method working files — ignore content but keep the stub so the
# directory exists in all worktrees.
ai/findings/*
!ai/findings/.gitkeep

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

target
.claude/scheduled_tasks.lock
ai/worktrees/
.aqua/

# Generated TLS / signing-key files (written by u7s-apiserver on first start)
ca.key
ca.crt
admin.key
admin.crt
proxy-client-ca.key
proxy-client-ca.crt
sa.key
sa.pub
/kubeconfig

# Local dev state (scripts/u7s-start.sh); temp/u7s/ lives in each worktree
temp/*

.claude/scheduled_tasks.json
.claude/plans/

# Critical-reviewer queue: hook writes review-request markers here; ephemeral.
.claude/review-queue/*
!.claude/review-queue/.gitkeep
