{
  "mcpServers": {
    "lima-node": {
      "transport": "stdio",
      "command": "limactl",
      "args": [
        "mcp",
        "serve",
        "lima-node"
      ]
    },
    "mcpls": {
      "command": "mcpls",
      "args": []
    },
    "u7s": {
      "type": "stdio",
      "command": "cargo",
      "args": [
        "run",
        "--quiet",
        "--manifest-path",
        "/Users/balint.erdos/u7s/Cargo.toml",
        "-p",
        "u7s-mcp-server"
      ]
    }
  }
}
