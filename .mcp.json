{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "git": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-git", "--repository", "."]
    },
    "u7s": {
      "type": "stdio",
      "command": "cargo",
      "args": ["run", "--quiet", "--manifest-path", "/Users/balint.erdos/u7s/Cargo.toml", "-p", "u7s-mcp-server"]
    }
  }
}
