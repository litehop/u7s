ExecStart=/usr/local/bin/kube-controller-manager --kubeconfig=/var/lib/u7s/kcm-kubeconfig --authentication-kubeconfig=/var/lib/u7s/kcm-kubeconfig --authorization-kubeconfig=/var/lib/u7s/kcm-kubeconfig --cluster-signing-cert-file=/var/lib/u7s/intermediate-cert.pem --cluster-signing-key-file=/var/lib/u7s/intermediate.key --cluster-signing-duration=8760h --root-ca-file=/var/lib/u7s/ca-bundle.pem --controllers=*,bootstrap-signer-controller,token-cleaner-controller,-clusterrole-aggregation-controller,-service-cidr-controller --allocate-node-cidrs=true --cluster-cidr=10.244.0.0/16 --service-cluster-ip-range=10.96.0.0/12 --node-cidr-mask-size=24 --use-service-account-credentials=true --leader-elect=false --bind-address=127.0.0.1 --kube-api-content-type=application/json
