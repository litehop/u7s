{
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(bd *)",
      "Bash(cargo *)",
      "Bash(gh *)",
      "Bash(git *)",
      "Bash(jq *)",
      "Bash(kubectl *)",
      "Bash(limactl *)",
      "Bash(rustc *)",
      "Bash(rustup *)",
      "mcp__lima-node__*",
      "mcp__mcpls__*",
      "mcp__u7s__*"
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "hooks": {
    "WorktreeCreate": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/create-worktree.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/assert-worktree-boundary.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cmd=$(echo \"$CLAUDE_TOOL_INPUT\" | jq -r '.command // \"\"' 2>/dev/null || echo ''); case \"$cmd\" in *\"git push\"*) cargo test --workspace --quiet && cargo clippy --workspace --quiet -- -D warnings && cargo fmt --check ;; esac"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "enabledMcpjsonServers": [
    "lima-node",
    "mcpls"
  ]
}
