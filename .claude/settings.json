{
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "mcp__github__*",
      "mcp__git__*",
      "Bash(cargo *)",
      "Bash(bd *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(find *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(grep *)",
      "Bash(rustup *)",
      "Bash(rustc *)",
      "Bash(cat *)",
      "Bash(mkdir *)",
      "Bash(echo *)",
      "Bash(jq *)",
      "Bash(touch *)",
      "Bash(rm *)",
      "Bash(cp *)",
      "Bash(mv *)"
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "WorktreeCreate": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/create-worktree.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/assert-worktree-boundary.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cmd=$(echo \"$CLAUDE_TOOL_INPUT\" | grep -o '\"command\":\"[^\"]*\"' | head -1 | sed 's/\"command\":\"//;s/\"//'); case \"$cmd\" in \"git push\"*) cargo test --workspace --quiet && cargo clippy --workspace --quiet -- -D warnings ;; esac"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  }
}